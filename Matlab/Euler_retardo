clc; clear; close all;
hold on;

h = 1;
T = 0.01;
t0 = -1;
tf = 5;
a0 = -3;
a1 = 2;

n = (tf - t0)/T + 1;
m = h/T + 1;
t = zeros(1, n);
x = zeros(1, n);

%condicion inicial
t1=0;
for i = 1:m
    x(i) = cos(t1*2*pi/h);
    t1 = t1+T;
end

t(1:m) = -h:T:0;

for i = m:n-1
    x(i+1) = x(i) + T * (a0 * x(i) + a1 * x(i-(m-1)));
    t(i+1) = t(i) + T;
end

plot(t, x, 'b-');
