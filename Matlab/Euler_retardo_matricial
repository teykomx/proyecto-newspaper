clc; clear; close all; hold on;

h = 0.5;
T = 0.01;
t0 = 0;
tf = 5;

n = (tf - t0)/T + 1;
m = h/T + 1;
t = zeros(1, n);
x = zeros(2, n);

%condición inicial
t1=0;
for i = 1:m
    x(1,i) = cos(t1*2*pi/h);
    x(2,i) = sin(t1*2*pi/h);
    t1 = t1+T;
end
t(1:m) = -h:T:0;

% Sistema
A0 = [-1,-2;3,-1];
A1 = [-1,0;0,-2];

for i = m:n-1
    x(:, i+1) = x(:, i) + T * (A0 * x(:,i) + A1 * x(:, i-(m-1)));
    t(i+1) = t(i) + T;
end

plot(t, x(1,:), 'b-');
plot(t, x(2,:), 'r-');
